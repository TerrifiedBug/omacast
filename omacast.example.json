{
  // Settings > Advanced > Edit config file creates ~/.config/omarchy/omacast.json
  // from this example and opens it. Edit entries here or in the palette.
  // Hand edits accept comments and trailing commas and apply as soon as you save.
  // In-palette Settings saves plain JSON each time, dropping comments.

  // Keyword of the quicklink used for the web fallback row.
  // Built-ins: g (Google), ddg, yt, gh, aw (Arch Wiki), aur, w (Wikipedia).
  "searchEngine": "g",

  // Name a built-in here to drop it, e.g. ["ddg", "aur"].
  // Set "builtinQuicklinks": false to drop all of them.
  "hiddenQuicklinks": [],

  // A keyword matching a built-in replaces it.
  // { "name": "Work GitHub", "keyword": "gh", "url": "https://github.com/my-org/{argument}" }
  "quicklinks": [],

  // Typed into the window you came from. {argument}, {clipboard}, {selection},
  // {date}, {time}, {datetime}, {day} and {uuid} all work.
  // { "name": "Today", "keyword": "td", "text": "{date format=\"yyyy-MM-dd\"}" }
  "snippets": [],

  // Words after the keyword arrive as "$@", never spliced into the string.
  // "terminal": true runs it in a floating terminal, "confirm": true asks first.
  // { "name": "Prune docker", "keyword": "prune", "command": "docker system prune -f", "confirm": true }
  "commands": [],

  // Extra folders of Raycast-format script commands, beside the default
  // ~/.config/omarchy/omacast/scripts. "~/" means your home.
  "scriptDirs": [],

  // The preview pane beside the list, on screens at least 1400 px wide.
  "preview": true,

  // Off unless you turn them on. "currency" downloads the ECB reference
  // rates at most once a day; "ai" adds an "Ask <agent>" row that hands the
  // query to `omarchy agent prompt`.
  "currency": false,
  "ai": false,

  // Disabled until enabled in Settings > Window management.
  // Empty assignments leave native layouts alone. Assign a preset in the palette.
  "windowManagement": {
    "enabled": false,
    "monitors": {},
    "workspaces": {},
    "customSizes": []
  },

  // Aliases are set per result through Ctrl+K. Query learning is separate,
  // off by default, and stores bounded hashed contexts in private state.
  "queryLearning": false,

  // Empty means Home. Include Home explicitly when adding other roots:
  // [{"name":"Home","path":"~"},{"name":"Work","path":"~/work"}]
  "fileRoots": [],
  "protectPreviews": true,
  // Explicit file or directory allowances for protected content/previews.
  "allowProtectedPaths": [],

  // Local navigation sources. Disabled sources do no discovery.
  "projectsEnabled": false,
  "projectRoots": [],
  "zoxideEnabled": false,
  "sshEnabled": false,
  // Enabled with an empty list uses ~/.ssh/config and bounded local Includes.
  "sshConfigFiles": [],
  "bookmarksEnabled": false,
  // Explicit Chromium JSON or Firefox bookmark-export JSON files.
  "bookmarkFiles": [],
  "pluginPanelsEnabled": false,

  "scriptForms": true,
  // Explicit send only. The default isolated omp command needs exported
  // provider credentials; it doesn't inherit normal stored login/config files.
  "inlineAi": false,
  // An explicit trusted command receives the question as its last argument.
  "agentCommand": [],
  // Real embeddings from a loopback-only service. No request without a model.
  "semantic": false,
  "semanticEndpoint": "http://127.0.0.1:11434",
  "semanticModel": ""
}
